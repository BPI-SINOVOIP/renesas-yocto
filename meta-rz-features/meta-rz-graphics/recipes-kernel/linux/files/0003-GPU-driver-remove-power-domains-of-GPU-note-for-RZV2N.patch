From f427db16b4f59a46d14a6b96621a36a126a75c6f Mon Sep 17 00:00:00 2001
From: trungvanle <trung.le.xk@renesas.com>
Date: Mon, 17 Nov 2025 11:05:16 +0700
Subject: [PATCH] GPU driver: remove power-domains of GPU note for RZV2N

Due to avoid duplicated clock control between the CPG genpd and
the mali-kbase driver, let mali-kbase handle the GPU clocks itself

Signed-off-by: Sang Ngo <sang.ngo.yf@renesas.com>
---
 arch/arm64/boot/dts/renesas/r9a09g056.dtsi | 1 -
 1 file changed, 1 deletion(-)

diff --git a/arch/arm64/boot/dts/renesas/r9a09g056.dtsi b/arch/arm64/boot/dts/renesas/r9a09g056.dtsi
index ce1b807b8b86..d11bb3994b35 100644
--- a/arch/arm64/boot/dts/renesas/r9a09g056.dtsi
+++ b/arch/arm64/boot/dts/renesas/r9a09g056.dtsi
@@ -1068,7 +1068,6 @@ gpu: gpu@14850000 {
 				 <&cpg 0xde>,
 				 <&cpg 0xdf>;
 			reset-names = "rst", "axi_rst", "ace_rst";
-			power-domains = <&cpg>;
 			operating-points-v2 = <&gpu_opp_table>;
 			status = "disabled";
 		};
-- 
2.25.1

