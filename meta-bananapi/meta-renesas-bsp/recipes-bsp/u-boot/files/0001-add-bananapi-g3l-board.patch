+			partition@0 {
+				label = "bl2";
+				reg = <0x00000000 0x00060000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "fip";
+				reg = <0x00060000 0x00780000>;
+				read-only;
+			};
+
+			partition@7E0000 {
+				label = "env";
+				reg = <0x007E0000 0x00020000>;
+			};
+
+			partition@800000 {
+				label = "user";
+				reg = <0x00800000 0x00800000>;
+			};
+		};
+	};
+};
+
+#if 0
+&ehci0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&usb0_pins>;
