index 0000000000..9df288df5b
--- /dev/null
+++ b/plat/renesas/rz/soc/g3l/drivers/otp.c
@@ -0,0 +1,114 @@
+/*
+ * Copyright (c) 2026, Renesas Electronics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <stdint.h>
+#include <lib/mmio.h>
+#include <common/debug.h>
+#include <drivers/delay_timer.h>
+#include <otp.h>
+#include <cpg.h>
+
+static enum otp_result otp_poll_32(uintptr_t addr, uint32_t mask, uint32_t verify_value)
+{
+	uint8_t retries = OTP_POLL_RETRIES;
+
+	while (retries--) {
+		if (verify_value == (mmio_read_32(addr) & mask))
+			return OTP_RES_PASS;
+		mdelay(10);
+	}
+	return OTP_RES_FAIL;
+}
+
+static enum otp_result otp_power_on(void)
+{
+	/* OTP Clocks should be enabled by default */
+
+	if (OTP_PWR_OFF != (mmio_read_32(OTPPWR) & OTP_PWR_MASK)) {
+		ERROR("OTP power is not off\n");
+		return OTP_RES_FAIL;
+	}
+	if (OTP_CMD_RDY_BAD != (mmio_read_32(OTPSTR) & OTP_CMD_RDY_MASK)) {
+		ERROR("Should not be ready for commands\n");
+		return OTP_RES_FAIL;
+	}
+	if (OTP_FLAG_COMPLETE != (mmio_read_32(OTPFLAG) & OTP_FLAG_MASK)) {
+		ERROR("Setting changes are not complete\n");
+		return OTP_RES_FAIL;
+	}
+
+	mmio_write_32(OTPPWR, mmio_read_32(OTPPWR) | OTP_ACCL_MASK);
+
+	mmio_write_32(OTPPWR, mmio_read_32(OTPPWR) | OTP_PWR_MASK);
+
+	return OTP_RES_PASS;
+}
+
+static enum otp_result otp_power_off(void)
+{
+	/* Dummy read prevent unintended reads*/
+	mmio_write_32(OTPADRRD, OTPDUMMY);
+	volatile uint32_t dummy_result __attribute__((unused)) = mmio_read_32(OTPDATARD);
+
+	mmio_write_32(OTPPWR, mmio_read_32(OTPPWR) & ~OTP_PWR_MASK);
+	mmio_write_32(OTPPWR, mmio_read_32(OTPPWR) & ~OTP_ACCL_MASK);
+
+	if (OTP_RES_FAIL == otp_poll_32(OTPSTR, OTP_CMD_RDY_MASK, OTP_CMD_RDY_BAD)) {
+		ERROR("OTP not powered off correctly\n");
+		return OTP_RES_FAIL;
+	}
+
+	return OTP_RES_PASS;
+}
+
+enum otp_result otp_read_data_register(uint32_t address, uint8_t num_regs, uint32_t *result)
+{
+	if (result == NULL) {
+		ERROR("Null check fail\n");
+		return OTP_RES_FAIL;
+	}
+
+	if (num_regs == 0) {
+		ERROR("The number of registers read is out of range\n");
+		return OTP_RES_FAIL;
+	}
+
+	if ((address < OTP_DATA_ADDR_MIN) || ((address + num_regs-1) > OTP_DATA_ADDR_MAX)) {
+		ERROR("OTP address reads out of range\n");
+		return OTP_RES_FAIL;
+	}
+
+	if (OTP_RES_FAIL == otp_power_on()) {
+		ERROR("OTP power on during read failed\n");
+		return OTP_RES_FAIL;
+	}
+
+	if (OTP_RES_FAIL == otp_poll_32(OTPSTR, OTP_CMD_RDY_MASK, OTP_CMD_RDY_OK)) {
+		otp_power_off();
+		ERROR("OTP not ready for command\n");
+		return OTP_RES_FAIL;
+	}
+
+	mmio_write_32(OTPADRRD, address);
+
+	while (num_regs--) {
+		*result = mmio_read_32(OTPDATARD);
+
+		if (OTP_ERR_RP_NONE != (mmio_read_32(OTPSTR) & OTP_ERR_RP_MASK)) {
+			ERROR("OTP read fail\n");
+			otp_power_off();
+			return OTP_RES_FAIL;
+		}
+		result++;
+	}
+
+	if (OTP_RES_FAIL == otp_power_off()) {
+		ERROR("OTP power off during read failed\n");
+		return OTP_RES_FAIL;
+	}
+
+	return OTP_RES_PASS;
+}
diff --git a/plat/renesas/rz/soc/g3l/include/otp.h b/plat/renesas/rz/soc/g3l/include/otp.h
new file mode 100644
index 0000000000..ed4058d239
--- /dev/null
+++ b/plat/renesas/rz/soc/g3l/include/otp.h
@@ -0,0 +1,76 @@
+/*
+ * Copyright (c) 2026, Renesas Electronics Corporation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+#include <stdint.h>
+
+#ifndef __OTP_H__
+#define __OTP_H__
+
+#define OTP_BASE			(0x11860000)
+#define OTP_POLL_RETRIES	(10)
+
+/* OTP Control registers */
+#define OTPPWR			(OTP_BASE + 0x00)	/* OTP Power Configuration Register */
+#define OTPSTR			(OTP_BASE + 0x04)	/* OTP Status Register */
+#define OTPSTAWR		(OTP_BASE + 0x08)	/* OTP Write Command Start Register */
+#define OTPADRWR		(OTP_BASE + 0x0C)	/* OTP Write Address Register */
+#define OTPDATAWR		(OTP_BASE + 0x10)	/* OTP Write Data Register */
+#define OTPADRRD		(OTP_BASE + 0x14)	/* OTP Read Address Register */
+#define OTPDATARD		(OTP_BASE + 0x18)	/* OTP Read Data Register */
+#define OTPFLAG			(OTP_BASE + 0x1C)	/* OTP Flag Register */
+
+/* OTPPWR bit map */
+#define OTP_PWR_MASK		(1 << 0) /* Power setting for the OTP macro 1=ON 0=OFF */
+#define OTP_PWR_ON			(1 << 0)
+#define OTP_PWR_OFF			(0 << 0)
+
+#define OTP_ACCL_MASK		(1 << 4) /* OTP accses mode 1=Normal 0=Set to zero during AWO transition to ALL_ON */
+#define OTP_ACCL_NORMAL		(1 << 4)
+#define OTP_ACCL_TRANS		(0 << 4)
+
+/* OTPSTR bit map */
+#define OTP_CMD_RDY_MASK	(1 << 0) /* Command ready 1=Ready for commands 0=Not ready for commands*/
+#define OTP_CMD_RDY_OK		(1 << 0)
+#define OTP_CMD_RDY_BAD		(0 << 0)
+
+#define OTP_ERR_RP_MASK		(1 << 4) /* Read protection error mask */
+#define OTP_ERR_RP_NONE		(0 << 4) /* Read protection error: 0=no error*/
+
+#define OTP_ERR_WR_MASK		(0x3 << 1) /* Write error */
+#define OTP_ERR_WP_MASK		(1 << 3) /* Write protection error */
+
+/* OTPSTAWR bit map */
+#define OTP_STAWR_MASK		(1 << 0) /* Start the OTP write */
+#define OTP_STAWR_START		(1 << 0) /* Start the OTP write */
+#define OTP_STAWR_DONE		(0 << 0) /* No OTP write in progress */
+
+/* OTPFLAG bit map */
+#define OTP_FLAG_MASK		(1 << 0) /* 1= setting changes are complete */
+#define OTP_FLAG_COMPLETE	(1 << 0)
+#define OTP_FLAG_BUSY		(0 << 0)
+
+/* OTPADRRD bit map */
+#define OTP_DATA_ADDR_MIN	(0x150)
+#define OTP_DATA_ADDR_MAX	(0x1FF)
+
+/* OTP data storage registers */
+#define OTPCPID0			(0x150)	/* Chip ID Register */
+#define OTPCPID1			(0x151)	/* Chip ID Register */
+#define OTPCPID2			(0x152)	/* Chip ID Register */
+#define OTPCPID3			(0x153)	/* Chip ID Register */
+#define OTPPRODID			(0x158)	/* Product ID Register */
+#define OTPDUMMY			(0x15D) /* Dummy Read Register*/
+#define OTPOTREN			(0x16A) /* Enable Area Register */
+#define OTPPOC				(0x16C) /* Boot Device Drive Strength Register */
+
+enum otp_result {
+	OTP_RES_PASS,
+	OTP_RES_FAIL,
+};
+
+/* OTP control functions */
+enum otp_result otp_read_data_register(uint32_t address, uint8_t num_regs, uint32_t *result);
+
+#endif /* __OTP_H__ */
