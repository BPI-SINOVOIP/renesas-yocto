diff --git a/arch/arm64/boot/dts/renesas/overlay/README.renesas-overlays b/arch/arm64/boot/dts/renesas/overlay/README.renesas-overlays
new file mode 100644
index 000000000000..f24b54652492
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlay/README.renesas-overlays
@@ -0,0 +1,18 @@
+This document describes overlays provided in the kernel packages
+For generic Renesas overlays
+
+### Platform:
+
+Renesas (Renesas)
+
+### Provided overlays:
+
+- i2c4
+
+### Overlay details:
+
+### i2c4
+
+Activates TWI/I2C bus 4
+
+I2C4 pins (SCL, SDA): GPIO PIN.3, GPIO PIN.5
diff --git a/arch/arm64/boot/dts/renesas/overlay/bpi-g3l-cam-ov5640.dtso b/arch/arm64/boot/dts/renesas/overlay/bpi-g3l-cam-ov5640.dtso
new file mode 100644
index 000000000000..2a6e76f44e50
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlay/bpi-g3l-cam-ov5640.dtso
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Device Tree overlay for the Bananapi BPI-G3L with an OV5640 camera
+ * connected to CSI2.
+ *
+ * Copyright (C) 2025 Renesas Electronics Corp.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/renesas,r9a08g046-pinctrl.h>
+
+&{/} {
+	clk_ext_camera: camera-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	ov5640_vdddo_1v8: camera-vdddo-1p8v {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_vdddo";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	ov5640_vdda_2v8: camera-vdda-2p8v {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_vdda";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		regulator-always-on;
+	};
+
+	ov5640_vddd_1v5: camera-vddd-1p5v {
+		compatible = "regulator-fixed";
+		regulator-name = "camera_vddd";
+		regulator-min-microvolt = <1500000>;
+		regulator-max-microvolt = <1500000>;
+		regulator-always-on;
+	};
+};
+
+&cru {
+	status = "okay";
+};
+
+&csi2 {
+	status = "okay";
+
+	ports {
+		port@0 {
+			reg = <0>;
+			csi2_in: endpoint {
+				clock-lanes = <0>;
+				data-lanes = <1 2>;
+				remote-endpoint = <&ov5640_to_csi2>;
+			};
+		};
+	};
+};
+
+&i2c1 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ov5640_csi2: camera@3c {
+		compatible = "ovti,ov5640";
+		reg = <0x3c>;
+		clock-names = "xclk";
+		clocks = <&clk_ext_camera>;
+		clock-frequency = <24000000>;
+		DOVDD-supply = <&ov5640_vdddo_1v8>;
+		AVDD-supply = <&ov5640_vdda_2v8>;
+		DVDD-supply = <&ov5640_vddd_1v5>;
+		powerdown-gpios = <&pinctrl RZG3L_GPIO(M, 6) GPIO_ACTIVE_HIGH>; /* CSI1_PWDNB */
+		reset-gpios = <&pinctrl RZG3L_GPIO(M, 7) GPIO_ACTIVE_LOW>; /* CSI1_RESET */
+
+		port {
+			ov5640_to_csi2: endpoint {
+				clock-lanes = <0>;
+				data-lanes = <1 2>;
+				remote-endpoint = <&csi2_in>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/renesas/overlay/renesas-fixup.scr-cmd b/arch/arm64/boot/dts/renesas/overlay/renesas-fixup.scr-cmd
new file mode 100644
index 000000000000..d4c39e20a3a2
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlay/renesas-fixup.scr-cmd
@@ -0,0 +1,4 @@
+# overlays fixup script
+# implements (or rather substitutes) overlay arguments functionality
+# using u-boot scripting, environment variables and "fdt" command
+
-- 
2.43.0

