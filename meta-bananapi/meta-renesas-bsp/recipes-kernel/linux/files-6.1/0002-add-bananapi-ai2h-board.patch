+&xspi {
+	pinctrl-0 = <&xspi_pins>;
+	pinctrl-names = "default";
+	/*
+	 * MT25QU512ABB8E12 flash chip is capable of running at 166MHz
+	 * clock frequency. Set the clock frequency to the maximum 133MHz
+	 * supported by the RZ/V2H SoC.
+	 */
+	assigned-clocks = <&cpg CPG_CORE R9A09G057_SPI_CLK_SPI>;
+	assigned-clock-rates = <133333334>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		vcc-supply = <&reg_1p8v>;
+		m25p,fast-read;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "bl2";
+				reg = <0x00000000 0x00060000>;
+			};
+
+			partition@60000 {
+				label = "fip";
+				reg = <0x00060000 0x00780000>;
+			};
+
+			partition@7E0000 {
+				label = "env";
+				reg = <0x007E0000 0x00020000>;
+			};
+
+			partition@800000 {
+				label = "user";
+				reg = <0x00800000 0x03800000>;
+			};
+		};
+	};
+};
+
+/* 40pin uart0 */
+&sci0 {
+	pinctrl-0 = <&sci0_pins>;
+	pinctrl-names = "default";
+
+	uart-has-rtscts;
+	status = "disabled";
+};
+
+/* 40pin uart2 */
+&sci2 {
+	pinctrl-0 = <&sci2_pins>;
+	pinctrl-names = "default";
+
+	uart-has-rtscts;
+	status = "disabled";
+};
+
+&cmtw0 {
+	status = "okay";
+};
+
+&cmtw1 {
+	status = "okay";
+};
+
+&rtc_clk {
+	clock-frequency = <32768>;
+};
+
+&rtc {
+	status = "disabled";
+};
+
+/* 40pin spi0 */
+&rspi0 {
+	pinctrl-0 = <&rspi0_pins>;
+	pinctrl-names = "default";
+	num-cs = <2>;
+
+	status = "disabled";
+};
+
+/* 40pin spi2 */
+&rspi2 {
+	pinctrl-0 = <&rspi2_pins>;
+	pinctrl-names = "default";
+	num-cs = <2>;
+
+	status = "disabled";
+};
+
+&pcie0 {
+	/* First 128MB is reserved for secure area. */
+	dma-ranges = <0x42000000 0 0x48000000 0 0x48000000 0x3 0xF8000000>;
+	status = "okay";
+};
+
+&drp1 {
+	memory-region = <&drp_codec>;
+	memory-oca-region = <&opencva_reserved>;
+	status = "okay";
+};
+
+&drpai0 {
+	memory-region = <&drp_reserved>;
+	status = "okay";
