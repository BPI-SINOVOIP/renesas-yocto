+/dts-v1/;
+/plugin/;
+#include <dt-bindings/pwm/pwm.h>
+
+/ {
+	compatible = "renesas,r9a09g057";
+
+	fragment@0 {
+		target-path = "/soc/gpt@13010500";
+		__overlay__ {
+			#pwm-cells = <3>;
+			status = "okay";
+
+			channel = "channel_B";
+		};	
+	};
+
+	fragment@1 {
+		target-path = "/";
+		__overlay__ {
+		        pwm_fan: pwm-fan {
+				compatible = "pwm-fan";
+				cooling-levels = <0 120 170 220>;
+				#cooling-cells = <2>;
+				fan-supply = <&reg_1p8v>;
+				pwms = <&gpt0_5 0 50000 PWM_POLARITY_INVERTED>;
+			};
+		};
+	};
+
+	fragment@2 {
+		target-path = "/gpio-fan";
+		__overlay__ {
+			status = "disabled";
+		};
+	};
+
+	fragment@3 {
+		target = <&cpu_thermal0>;
+		__overlay__ {
+			trips {
+				/delete-node/ fan-active;
+
+				cpu_active: cpu-active {
+					temperature = <65000>;
+					hysteresis = <2000>;
+					type = "active";
+				};
+
+				cpu_warm: cpu-warm {
+					temperature = <75000>;
+					hysteresis = <2000>;
+					type = "active";
+				};
+
+				cpu_hot: cpu-hot {
+					temperature = <85000>;
+					hysteresis = <2000>;
+					type = "active";
+				};
+			};
+
+			cooling-maps {
+				/delete-node/ map1;
+
+				map1 {
+					trip = <&cpu_active>;
+					cooling-device = <&pwm_fan 1 1>;
+				};
+
+				map2 {
+					trip = <&cpu_warm>;
+					cooling-device = <&pwm_fan 2 2>;
+				};
+
+				map3 {
+					trip = <&cpu_hot>;
+					cooling-device = <&pwm_fan 3 3>;
+				};
+			};
+		};
+	};
+
+};
