+&pinctrl {
+	rspi0_pins: rspi0 {
+		pinmux = <RZV2H_PORT_PINMUX(9, 1, 1)>, /* MISO */
+			 <RZV2H_PORT_PINMUX(9, 0, 1)>, /* MOSI */
+			 <RZV2H_PORT_PINMUX(9, 3, 1)>, /* CS0 */
+			 <RZV2H_PORT_PINMUX(9, 5, 1)>, /* CS1 */
+			 <RZV2H_PORT_PINMUX(9, 2, 1)>; /* SCK */
+	};
+
+	rspi2_pins: rspi2 {
+		pinmux = <RZV2H_PORT_PINMUX(B, 3, 5)>, /* MISO */
+			 <RZV2H_PORT_PINMUX(B, 4, 5)>, /* MOSI */
+			 <RZV2H_PORT_PINMUX(A, 7, 5)>, /* CS0 */
+			 <RZV2H_PORT_PINMUX(A, 6, 5)>, /* CS1 */
+			 <RZV2H_PORT_PINMUX(B, 5, 5)>; /* SCK */
+	};
+
+	/* UART */
+	sci0_pins: sci0 {
+		pinmux = <RZV2H_PORT_PINMUX(5, 0, 1)>, /* SCI0_TXD_MOSI_SDA */
+			 <RZV2H_PORT_PINMUX(5, 1, 1)>, /* SCI0_RXD_MISO_SCL */
+			 <RZV2H_PORT_PINMUX(5, 2, 4)>, /* SCI0_CTS */
+			 <RZV2H_PORT_PINMUX(5, 3, 2)>; /* SCI0_RTS */
+		bias-pull-up;
+	};
+
+	sci2_pins: sci2 {
+		pinmux = <RZV2H_PORT_PINMUX(5, 4, 1)>, /* SCI2_TXD_MOSI_SDA */
+			 <RZV2H_PORT_PINMUX(5, 5, 1)>, /* SCI2_RXD_MISO_SCL */
+			 <RZV2H_PORT_PINMUX(5, 6, 1)>, /* SCI2_CTS */
+			 <RZV2H_PORT_PINMUX(5, 7, 1)>; /* CSI2_RTS */
+		bias-pull-up;
+	};
+
+	eth0_pins: eth0 {
+		pins = "ET0_TXC_TXCLK";
+		output-enable;
+	};
+
+	eth1_pins: eth1 {
+		pins = "ET1_TXC_TXCLK";
+		output-enable;
+	};
+
+	i2c0_pins: i2c0 {
+		pinmux = <RZV2H_PORT_PINMUX(3, 0, 1)>, /* I2C0_SDA */
+			 <RZV2H_PORT_PINMUX(3, 1, 1)>; /* I2C0_SCL */
+	};
+
+	i2c1_pins: i2c1 {
