+
+/ {
+        compatible = "renesas,r9a09g057";
+
+        fragment@0 {
+                target-path = "/";
+
+                __overlay__ {
+			
+			vdd5v0_dsi: regulator-vdd5v0-dsi {
+				compatible = "regulator-fixed";
+				regulator-name = "dsi-panel-power-5v";
+				regulator-min-microvolt = <5000000>;
+				regulator-max-microvolt = <5000000>;
+				startup-delay-us = <20000>;
+				gpios = <&pinctrl RZV2H_GPIO(8, 3) GPIO_ACTIVE_HIGH>;
+				enable-active-high;
+				vin-supply = <&vdd5v0_sys>;
+			};
+
+			vdd3v0_dsi: regulator-vdd3v0-dsi {
+				compatible = "regulator-fixed";
+				regulator-name = "dsi-panel-power-3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+				vin-supply = <&vdd5v0_dsi>;
+			};
+
+		        backlight: backlight {
+				compatible = "pwm-backlight";
+				power-supply = <&vdd5v0_dsi>;
+				enable-gpios = <&pinctrl RZV2H_GPIO(4, 2) GPIO_ACTIVE_HIGH>;
+				pwms = <&gpt0_3 0 50000 0>;
+				brightness-levels = <0 5 10 15 20 30 40 55 70 85 100>;
+				default-brightness-level = <6>;
+			};
+
+			hdmi-out {
+				status = "disabled";
+			};
+		};
+	};
+
+	fragment@1 {
+		target = <&dsi0>;
+		 __overlay__ {
+
+			ports {
+				port@1 {
+					dsi0_out: endpoint {
+						data-lanes = <1 2 3 4>;
+						remote-endpoint = <&panel_in>;
+					};
+				};
+			};
+
+			panel@0 {
+				compatible = "bananapi,hc070iy30025";
+				reg = <0>;
+				power-supply = <&vdd3v0_dsi>;
+				//enable-gpios = <&pinctrl RZV2H_GPIO(4, 2) GPIO_ACTIVE_HIGH>;
+				reset-gpios = <&pinctrl RZV2H_GPIO(4, 3) GPIO_ACTIVE_HIGH>;
+				backlight = <&backlight>;
+
+				port {
+					panel_in: endpoint {
+						remote-endpoint = <&dsi0_out>;
+					};
+				};
+			};
+		};	
+	};
+
+	fragment@2 {
+		target = <&pinctrl>;
+		 __overlay__ {
+			
+			backlight_pins: backlight {
+				pins =  "P8_2";
+			};
+		};
+	};
+
+	fragment@3 {
+		target = <&adv7535>;
+
+		__overlay__ {
+			status = "disabled";
+		};
+	};
+
+	fragment@4 {
+		target = <&i2c3>;
+
+		__overlay__ {
+
+			touchscreen@5d {
+				compatible = "goodix,gt911";
+				reg = <0x5d>;
+				interrupt-parent = <&pinctrl>;
+				interrupts = <RZV2H_GPIO(4, 1) IRQ_TYPE_EDGE_FALLING>;
+				AVDD28-supply = <&vdd3v0_dsi>;
+				VDDIO-supply = <&reg_1p8v>;
+				irq-gpios = <&pinctrl RZV2H_GPIO(4, 1) GPIO_ACTIVE_HIGH>;
+				reset-gpios = <&pinctrl RZV2H_GPIO(4, 0) GPIO_ACTIVE_HIGH>;
+			};
+		};
+	};
+
+	fragment@5 {
+		target = <&gpt0_3>;
+
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@6 {
+		target = <&pinctrl>;
+
+		__overlay__ {
+			sound_no_hdmi_pins: sound-no-hdmi {
+				sound_clk {
+					pinmux = <RZV2H_PORT_PINMUX(1, 0, 7)>,
+						 <RZV2H_PORT_PINMUX(1, 1, 7)>;
+				};
+			};
+		};
+	};
+
+	fragment@7 {
+		target = <&rcar_sound>;
+
+		__overlay__ {
+			pinctrl-0 = <&sound_no_hdmi_pins>;
+		};
+	};
+};
