+/ {
+	compatible = "renesas,r9a09g057";
+
+	fragment@0 {
+		target-path = "/aliases";
+		__overlay__ {
+			i2c9 = &i2c_mux0;
+			i2c10 = &i2c_mux1;
+			i2c11 = &i2c_mux2;
+			i2c12 = &i2c_mux3;
+		};
+	};
+
+	fragment@1 {
+		target = <&i2c0>;
+		__overlay__ {
+			status = "okay";
+
+			pca9545: i2c-mux@70 {
+				compatible = "nxp,pca9545";
+				reg = <0x70>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				reset-gpios = <&pinctrl RZV2H_GPIO(7, 4) GPIO_ACTIVE_HIGH>;
+
+				i2c_mux0: i2c@0 {
+				    reg = <0>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+
+				i2c_mux1: i2c@1 {
+				    reg = <1>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+
+				i2c_mux2: i2c@2 {
+				    reg = <2>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+
+				i2c_mux3: i2c@3 {
+				    reg = <3>;
+				    #address-cells = <1>;
+				    #size-cells = <0>;
+				};
+			};
+		};	
+	};
+
+	fragment@2 {
+		target-path = "/";
+
+		__overlay__ {
+			clk_ext_camera: clk_ext_camera {
+				compatible = "fixed-clock";
+				#clock-cells = <0>;
+				clock-frequency = <74250000>;
+			};
+
+			imx415_ovdd_1v8: 1p8v {
+				compatible = "regulator-fixed";
+				regulator-name = "camera_ovdd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+				regulator-always-on;
+			};
+
+			imx415_avdd_2v9: 2p9v {
+				compatible = "regulator-fixed";
+				regulator-name = "camera_avdd";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				regulator-always-on;
+			};
+
+			imx415_dvdd_1v1: 1p1v {
+				compatible = "regulator-fixed";
+				regulator-name = "camera_dvdd";
+				regulator-min-microvolt = <1100000>;
+				regulator-max-microvolt = <1100000>;
+				regulator-always-on;
+			};
+		};
+	};
+
+	fragment@3 {
+		target = <&pinctrl>;
+		__overlay__ {
+			cam0_pwr_en {
+				gpio-hog;
+				gpios = <RZV2H_GPIO(6, 1) GPIO_ACTIVE_HIGH>;
+				output-high;
+				line-name = "cam0_pwr_en";
+			};
+		};
+	};
+
+	fragment@4 {
+		target = <&i2c_mux0>;
+		__overlay__ {
+			status = "okay";
+
+			imx415a: imx415@1a {
+				compatible = "sony,imx415";
+				reg = <0x1a>;
+				clock-names = "inck";
+				clocks = <&clk_ext_camera>;
+				ovdd-supply = <&imx415_ovdd_1v8>;
+				avdd-supply = <&imx415_avdd_2v9>;
+				dvdd-supply = <&imx415_dvdd_1v1>;
+				reset-gpios = <&pinctrl RZV2H_GPIO(6, 0) GPIO_ACTIVE_LOW>;
+
+				port {
+					imx415a_to_csi20: endpoint {
+						clock-lanes = <0>;
+						data-lanes = <1 2 3 4>;
+						link-frequencies = /bits/ 64 <445500000 445500000 445500000 445500000>;
+						remote-endpoint = <&csi20_in>;
+					};
+				};
+			};
+		};
+	};
+
+	fragment@5 {
+		target = <&cru0>;
+		__overlay__ {
+			status = "okay";
+
+			memory-region = <&cru_func>;
+		};
+	};
+
+	fragment@6 {
+		target = <&csi20>;
+		__overlay__ {
+			status = "okay";
+			ports {
+				port@0 {
+					reg = <0>;
+					csi20_in: endpoint {
+						clock-lanes = <0>;
+						data-lanes = <1 2 3 4>;
+						remote-endpoint = <&imx415a_to_csi20>;
+					};
+				};
+			};
+		};
+	};
+
+	fragment@7 {
+		target = <&input_video_control>;
+		__overlay__ {
+			status = "okay";
+
+			crus = <&cru0>;
+		};
+	};
+
+	fragment@8 {
+		target = <&isp>;
+		__overlay__ {
+			status = "okay";
+
+			sensor-i2c = <&imx415a>;
+			sensor-default-preset-mode = <0>;
+		};
+	};
+
+	fragment@9 {
+		target = <&sensor>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@10 {
+		target = <&lens>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@11 {
+		target = <&iq>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+};
