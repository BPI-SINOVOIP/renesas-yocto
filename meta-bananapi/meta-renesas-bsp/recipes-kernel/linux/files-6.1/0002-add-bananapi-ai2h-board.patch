+			 <RZV2H_PORT_PINMUX(4, 7, 1)>; /* I2C7_SCL */
+	};
+
+	i2c8_pins: i2c8 {
+		pinmux = <RZV2H_PORT_PINMUX(0, 6, 1)>, /* I2C8_SDA */
+			 <RZV2H_PORT_PINMUX(0, 7, 1)>; /* I2C8_SCL */
+	};
+
+	sound_pins: sound {
+		/* hdmi */
+		ssi0_pins: ssi0 {
+			pinmux = <RZV2H_PORT_PINMUX(4, 0, 7)>, /* SSI0_SCK */
+				 <RZV2H_PORT_PINMUX(4, 1, 7)>, /* SSI0_WS */
+				 <RZV2H_PORT_PINMUX(4, 2, 7)>; /* SSI0_SDATA */
+		};
+
+		sound_clk_pins: sound_clk {
+			pinmux = <RZV2H_PORT_PINMUX(1, 0, 7)>, /* AUDIO_CLKB */
+				 <RZV2H_PORT_PINMUX(1, 1, 7)>; /* AUDIO_CLKC */
+		};
+	};
+
+	scif_pins: scif {
+		pins = "SCIF_TXD", "SCIF_RXD";
+		renesas,output-impedance = <1>;
+	};
