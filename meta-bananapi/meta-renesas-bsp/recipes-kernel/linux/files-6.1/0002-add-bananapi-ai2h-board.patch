diff --git a/arch/arm64/boot/dts/renesas/bananapi-ai2h-waveshare-jetson-io-a.dts b/arch/arm64/boot/dts/renesas/bananapi-ai2h-waveshare-jetson-io-a.dts
new file mode 100644
index 000000000000..b45300648818
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/bananapi-ai2h-waveshare-jetson-io-a.dts
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Device Tree Source for the waveshare jetson-io-base-a board
+ *
+ * Copyright (C) 2024 Renesas Electronics Corp.
+ */
+
+/dts-v1/;
+#include "bananapi-ai2h.dts"
+
+/ {
+        model = "Waveshare JETSON-IO-BASE-A with Bananapi AI2H Module";
+        compatible = "waveshare,jeston-base-a-ai2h", "renesas,r9a09g057h44", "renesas,r9a09g057";
+
+	/delete-node/ hdmi-out;
+};
+
+&pinctrl {
+	/*
+        sd1-pwr-en-hog {
+		gpio-hog;
+		gpios = <RZG2L_GPIO(8, 2) GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "sd1_pwr_en";
+	};*/
+
+	/delete-node/ sd1;
+};
+
+/* SD */
+&sdhi1 {
+	/delete-property/ sd-uhs-sdr50;
+	/delete-property/ sd-uhs-sdr104;
+	cap-sd-highspeed;
+	cd-gpios = <&pinctrl RZG2L_GPIO(8, 3) GPIO_ACTIVE_LOW>;
+	pinctrl-0;
+	pinctrl-1;
+	pinctrl-names;
+};
+
+&eth0 {
+	status = "disabled";
+};
+
+&dsi0_out {
+	/delete-property/ remote-endpoint;
+	/delete-property/ data-lanes;
+};
+
+&i2c1 {
+	/delete-node/ codec@1a;
+};
+
+&i2c3 {
+	/delete-node/ eeprom@56;
+	/delete-node/ hdmi@3d;
+	/delete-node/ rtc@51;
+};
+
+&rcar_sound {
+	ports {
+		/delete-node/ port@0;
+		/delete-node/ port@1;
+	};
+};
+
+&sound_card {
+	/delete-property/ dais;
+};
diff --git a/arch/arm64/boot/dts/renesas/bananapi-ai2h.dts b/arch/arm64/boot/dts/renesas/bananapi-ai2h.dts
new file mode 100644
index 000000000000..4f404dc8a52b
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/bananapi-ai2h.dts
@@ -0,0 +1,1082 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Device Tree Source for the Bananapi AI2H board
+ *
+ * Copyright (C) 2025 Renesas Electronics Corp.
+ */
+
+/dts-v1/;
+#include <dt-bindings/pinctrl/renesas,r9a09g057-pinctrl.h>
+#include <dt-bindings/soc/renesas,rsci.h>
+#include <dt-bindings/soc/renesas,gpt.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "r9a09g057.dtsi"
+
+/ {
+	model = "Bananapi BPI-AI2H";
+	compatible = "sinovoip,bpi-ai2h", "renesas,r9a09g057h44", "renesas,r9a09g057";
+
+	aliases {
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
+		i2c6 = &i2c6;
+		i2c7 = &i2c7;
+		i2c8 = &i2c8;
+		serial0 = &scif;
+		serial1 = &sci0;
+		serial2 = &sci2;
+		mmc0 = &sdhi0;
+		mmc1 = &sdhi1;
+		spi0 = &xspi;
+		spi1 = &rspi0;
+		spi2 = &rspi2;
+		ethernet0 = &eth0;
+		ethernet1 = &eth1;
+	};
+
+	chosen {
+		bootargs = "ignore_loglevel";
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@48000000 {
+		device_type = "memory";
+		/* first 128MB is reserved for secure area. */
+		reg = <0x0 0x48000000 0x1 0xF8000000>;
+	};
+
+	memory@240000000 {
+		device_type = "memory";
+		reg = <0x2 0x40000000 0x2 0x00000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		global_cma: linux,cma@58000000 {
+			compatible = "shared-dma-pool";
+			linux,cma-default;
+			reusable;
+			reg = <0x0 0x58000000 0x0 0x28000000>;
+		};
+
+		mmp_reserved: linux,multimedia {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x00000000 0x80000000 0x0 0x10000000>;
+		};
+
+		isp_reserved: frame_buffer@90000000 {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x0 0x90000000 0x0 0x18000000>;
+		};
+
+		opencva_reserved: OpenCVA@A8000000 {
+			reusable;
+			reg = <0x0 0xA8000000 0x0 0x7D00000>;
+		};
+
+		drp_codec: DRP-Codec@AFD00000 {
+			reusable;
+			reg = <0x0 0xAFD00000 0x0 0x300000>;
+		};
+
+		image_buf0: image_buf@B0000000 {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x0 0xB0000000 0x0 0x4000000>;
+			label = "image_buf0";
+		};
+
+		cru_func: cru_buffer@B4000000 {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x0 0xB4000000 0x0 0x16400000>;
+		};
+
+		drp_reserved: DRP-AI@240000000 {
+			reusable;
+			reg = <0x2 0x40000000 0x0 0x20000000>;
+		};
+	};
+
+	mmngr {
+		compatible = "renesas,mmngr";
+		memory-region = <&mmp_reserved>;
+	};
+
+	mmngrbuf {
+		compatible = "renesas,mmngrbuf";
+	};
+
+	vspm_if {
+		compatible = "renesas,vspm_if";
+	};
+
+	reg_0p8v: regulator-0p8v {
+		compatible = "regulator-fixed";
+		regulator-name = "reg-0.8V";
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	reg_1p8v: regulator-1p8v {
+		compatible = "regulator-fixed";
+		regulator-name = "reg-1.8V";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	reg_3p3v: regulator-3p3v {
+		compatible = "regulator-fixed";
+		regulator-name = "reg-3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd5v0_sys: regulator-vdd5v0-sys {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vdd5v0_sys";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* SD PWEN */
+	vmmc_sdhi1: regulator-vcc-sdhi1 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "SDHI1 Vmmc";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpios = <&pinctrl RZV2H_GPIO(A, 3) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/* SD IOVS */
+	vccq_sdhi1: regulator-vccq-sdhi1 {
+		compatible = "regulator-gpio";
+
+		regulator-name = "SDHI1 VccQ";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpios = <&pinctrl RZV2H_GPIO(A, 2) GPIO_ACTIVE_HIGH>;
+
+		gpios-states = <0>;
+		states = <3300000 0 1800000 1>;
+	};
+
+	vbus_reg: regulator_vbus {
+ 		compatible = "regulator-fixed";
+		regulator-name = "vbus-regulator";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		startup-delay-us = <20000>;
+		gpios = <&pinctrl RZV2H_GPIO(A, 4) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	rtl8821cu_reg: regulator_vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "rtl8821cu-regulator";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <20000>;
+		gpios = <&pinctrl RZV2H_GPIO(7, 3) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	hdmi_reg: regulator_hdmi {
+		compatible = "regulator-fixed";
+		regulator-name = "hdmi-regulator";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <20000>;
+		gpios = <&pinctrl RZV2H_GPIO(0, 5) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		status = "okay";
+
+		/* GPIO recovery key */
+		recovery {
+			interrupt-parent = <&pinctrl>;
+			interrupts = <RZV2H_GPIO(0, 3) IRQ_TYPE_LEVEL_LOW>;
+			//gpios = <&pinctrl RZV2H_GPIO(0, 3) GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_VENDOR>;
+			label = "GPIO Key Recovery";
+			debounce-interval = <100>;
+			//wakeup-source;
+		};
+
+		/* NMI power key */
+		power {
+			interrupt-parent = <&icu>;
+			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
+			linux,code = <KEY_POWER>;
+			label = "NMI Key Power";
+			debounce-interval = <100>;
+			//wakeup-source;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		core-led {
+			gpios = <&pinctrl RZV2H_GPIO(0, 1) GPIO_ACTIVE_HIGH>;
+			label = "core-led";
+			linux,default-trigger = "default-on";
+			default-state = "off";
+		};
+
+		carrier-led {
+			gpios = <&pinctrl RZV2H_GPIO(0, 0) GPIO_ACTIVE_HIGH>;
+                        label = "carrier-led";
+                        linux,default-trigger = "heartbeat";
+			default-state = "off";
+                };
+	};
+
+	gpio_fan: gpio-fan {
+		compatible = "gpio-fan";
+		status = "okay";
+		gpios = <&pinctrl RZV2H_GPIO(8, 5) GPIO_ACTIVE_HIGH>;
+		gpio-fan,speed-map = <0 1 3000 0>;
+		#cooling-cells = <2>;
+        };
+
+	hdmi-out {
+		compatible = "hdmi-connector";
+		type = "d";
+
+		port {
+			hdmi_con_out: endpoint {
+				remote-endpoint = <&adv7535_out>;
+			};
+		};
+	};
+
+	/* adv7535 */
+	osc1: cec-clock {
