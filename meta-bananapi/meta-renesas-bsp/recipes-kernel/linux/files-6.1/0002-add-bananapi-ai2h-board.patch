@@ -0,0 +1,89 @@
+/dts-v1/;
+/plugin/;
+#include <dt-bindings/pinctrl/renesas,r9a09g057-pinctrl.h>
+
+/ {
+	compatible = "renesas,r9a09g057";
+
+	fragment@0 {
+		target-path = "/aliases";
+		__overlay__ {
+			i2c1 = "/soc/i2c@14400800";
+		};
+	};
+
+	fragment@1 {
+		target-path = "/soc/i2c@14400800";
+		__overlay__ {
+			status = "okay";
+
+			pcm5122: pcm5122@4d {
+				compatible = "ti,pcm5122";
+				reg = <0x4d>;
+				#sound-dai-cells = <0>;
+				status = "okay";
+
+				port {
+					pcm5122_endpoint: endpoint {
+						remote-endpoint = <&rsnd_endpoint1>;
+					};
+				};
+			};
+		};	
+	};
+
+	fragment@2 {
+		target = <&sound_card>;
+		__overlay__ {
+			dais = <&rsnd_port0     /* HDMI0 */
+				&rsnd_port1	/* Codec */
+				>;
+		};
+	};
+
+	fragment@3 {
+		target = <&rcar_sound>;
+		__overlay__ {
+			/* Multi DAI */
+			#sound-dai-cells = <1>;
+
+			ports {
+				rsnd_port1: port@1 {
+					reg = <1>;
+					rsnd_endpoint1: endpoint {
+						remote-endpoint = <&pcm5122_endpoint>;
+
+						dai-format = "i2s";
+						bitclock-master = <&rsnd_endpoint1>;
+						frame-master = <&rsnd_endpoint1>;
+						mclk-fs = <256>;
+
+						playback = <&ssi3>, <&src0>, <&dvc0>;
+						capture = <&ssi4>, <&src1>, <&dvc1>;
+					};
+				};
+			};
+		};
+	};
+
+	fragment@4 {
+		target = <&sound_pins>;
+		__overlay__ {
+			ssi34_pins: ssi34 {
+				pinmux = <RZV2H_PORT_PINMUX(1, 2, 7)>, /* SSI3_SCK */
+					 <RZV2H_PORT_PINMUX(1, 3, 7)>, /* SSI3_WS */
+					 <RZV2H_PORT_PINMUX(0, 4, 7)>, /* SSI3_SDATA */
+					 <RZV2H_PORT_PINMUX(1, 5, 7)>; /* SSI4_SDATA */
+			};
+		};
+	};
+
+	fragment@5 {
+		target = <&sound_clk_pins>;
+		__overlay__ {
+			pinmux = <RZV2H_PORT_PINMUX(1, 0, 7)>, /* AUDIO_CLKB */
+				 <RZV2H_PORT_PINMUX(1, 1, 7)>, /* AUDIO_CLKC */
+				 <RZV2H_PORT_PINMUX(9, 7, 8)>; /* AUDIO_CLKOUT */
+		};
+	};
+};
